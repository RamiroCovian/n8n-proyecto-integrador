    {
      "parameters": {
        "jsCode": "const inputItem = $input.first().json;\n\nconst previousTurn = (inputItem.turn_count !== null && inputItem.turn_count !== undefined && !isNaN(inputItem.turn_count))  \n  ? Number(inputItem.turn_count)  \n  : 0;\n\nconst currentTurn = previousTurn + 1;\n\nreturn {\n  json: {\n    ...inputItem,\n    turn_count: Number(currentTurn) // <-- Formato numérico puro\n  }\n};"
      },
